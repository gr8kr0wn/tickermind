# Used only by `forge script` to deploy the contracts.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Wallet that pays deploy gas (Base Sepolia ETH)
DEPLOYER_PRIVATE_KEY=
# PUBLIC address of the operator wallet (the one whose private key goes in web/.env OPERATOR_PRIVATE_KEY)
OPERATOR_ADDRESS=
# Optional: verify contracts on BaseScan
BASESCAN_API_KEY=

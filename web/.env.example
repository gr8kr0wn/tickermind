# ─────────────────────────────────────────────────────────────
# TickerMind — copy this file to .env and fill in the values.
# On Vercel: Project → Settings → Environment Variables (same names).
# Every service below has a free tier.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string (e.g. run: openssl rand -hex 32)
SESSION_SECRET=

# Finnhub → https://finnhub.io/dashboard (free key)
FINNHUB_API_KEY=

# SEC asks for a contact in the User-Agent. Use your name + email.
SEC_USER_AGENT=TickerMind yourname@example.com

# Google AI Studio → Get API key (free tier)
GEMINI_API_KEY=
# Optional overrides — check AI Studio for the models free on your project
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Groq → https://console.groq.com/keys (free; used when Gemini is rate-limited)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Chain — 84532 = Base Sepolia (testnet). Leave as is for the hackathon.
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org

# Operator wallet: the backend wallet that releases escrow / refunds.
# Create a NEW wallet just for this, fund it with Base Sepolia ETH from a faucet.
OPERATOR_PRIVATE_KEY=

# Contract addresses — printed by the deploy script (see README step 3)
REGISTRY_ADDRESS=
VAULT_ADDRESS=
MARKETPLACE_ADDRESS=
# Circle USDC on Base Sepolia (default). Get test USDC at https://faucet.circle.com
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

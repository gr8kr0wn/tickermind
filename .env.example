# ---------- Required ----------
PORT=3000
# Any long random string: openssl rand -hex 32   (keeps wallet sign-ins valid across restarts)
SESSION_SECRET=

# 1 = judges can pay with simulated money (no wallet funds needed). Real testnet USDC payments work either way.
DEMO_MODE=1

# ---------- Free AI for reports (optional: without it, reports use a rule-based writer) ----------
# Get a free key at https://console.groq.com  (any OpenAI-compatible provider works)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# SEC asks for a real contact in the User-Agent: your name + email
SEC_USER_AGENT=TickerMind your-name your-email@example.com

# ---------- Database (optional: without it, a local JSON file is used) ----------
# Free Supabase project -> run supabase/schema.sql in the SQL editor -> paste URL + service_role key.
# Use Supabase on Railway: the local file is wiped on every redeploy.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Base Sepolia (fill after running `npm run contracts:deploy`) ----------
BASE_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
# Circle's official testnet USDC on Base Sepolia
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
AGENT_REGISTRY_ADDRESS=
MARKETPLACE_ADDRESS=

# ---------- Only for contracts:deploy on YOUR machine. Never set this on the server. ----------
DEPLOYER_PRIVATE_KEY=

# ---------- Tuning (defaults are fine) ----------
SCHEDULER_ENABLED=1
MAX_TASKS_PER_AGENT_PER_HOUR=20
ALLOWED_ORIGIN=*

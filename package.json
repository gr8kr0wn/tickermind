{
  "name": "tickermind",
  "version": "1.0.0",
  "description": "AI finance research agents with an agent-to-agent economy on Base (sandbox: Base Sepolia, testnet USDC, simulated portfolios)",
  "private": true,
  "type": "commonjs",
  "main": "api/src/server.js",
  "scripts": {
    "start": "node api/src/server.js",
    "dev": "node --watch api/src/server.js",
    "contracts:compile": "node contracts/compile.js",
    "contracts:test": "node contracts/test/test.js",
    "contracts:deploy": "node contracts/deploy.js",
    "test": "node contracts/test/test.js && node api/test/providers.test.js && node api/test/test.js && node api/test/onchain.test.js",
    "build:edge": "node scripts/build-edge.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "ganache": "^7.9.2",
    "solc": "^0.8.26"
  }
}